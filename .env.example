# =============================================================================
# VYRO Frontend Environment Configuration Template
# =============================================================================
# Copy this file to .env or .env.local to customize local settings.
# Do NOT commit sensitive credentials or secret keys to source control.

# Data source selection: 'mock' | 'http'
# - 'mock' (default): In-memory deterministic mock data. No backend needed.
# - 'http': Live REST API calls to the MERN backend.
VITE_DATA_SOURCE=mock

# Base URL for the MERN / REST API backend (used when VITE_DATA_SOURCE=http)
# Example local Express server: http://localhost:5000/api
# Example Vite proxy or production API: /api
VITE_API_BASE_URL=http://localhost:5000/api

# Request timeout in milliseconds for HTTP client requests
VITE_API_TIMEOUT_MS=10000
